config general 'main'
	option enabled '0'
	option main_outbound 'direct'
	option socks_port '1080'
	option http_port '0'
	option tproxy '0'
	option tproxy_port '12345'
	option lan_iface 'br-lan'
	option domain_strategy 'IPIfNonMatch'
	option loglevel 'warning'
	option probe_url 'https://www.gstatic.com/generate_204'
	option probe_interval '1m'
	option dns_enabled '0'
	option dns_hijack '1'
	option dns_port '5353'
	option dns_remote 'https://1.1.1.1/dns-query'
	option dns_local '77.88.8.8'
	option dns_query_strategy 'UseIPv4'
	list dns_local_domains 'geosite:category-ru'
	option dpi_test_timeout '8'
	list dpi_test_sites 'https://www.youtube.com/'
	list dpi_test_sites 'https://discord.com/'
	list dpi_test_sites 'https://rutracker.org/forum/index.php'

config byedpi 'byedpi'
	option enabled '0'
	option port '10801'
	option preset 'disorder1'

config zapret 'zapret'
	option enabled '0'
	option preset 'fake_md5_disorder'
	option qnum '200'
	option discord_voice '0'

config rule
	option name 'Russian sites directly'
	option enabled '1'
	option outbound 'direct'
	list domain 'geosite:category-ru'

config rule
	option name 'Russian IP addresses directly'
	option enabled '1'
	option outbound 'direct'
	list ip 'geoip:ru'

config rule
	option name 'Torrents directly'
	option enabled '1'
	option outbound 'direct'
	list protocol 'bittorrent'
